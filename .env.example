# ============================================================================
# MẪU CẤU HÌNH BÍ MẬT — [TÊN DỰ ÁN]
# ============================================================================
#
# HƯỚNG DẪN CHO ANH MIKE (làm 1 lần duy nhất):
#
#   Bước 1. Sao chép tệp này và đổi tên thành  .env  (đúng dấu chấm ở đầu)
#   Bước 2. Điền giá trị thật vào 2 dòng bên dưới
#   Bước 3. Mở lại ứng dụng
#
# CÁCH LẤY GIÁ TRỊ:
#   - Vào https://console.cloud.google.com/apis/credentials
#   - Chọn OAuth 2.0 Client ID của dự án
#   - Copy "Client ID" và "Client secret"
#
# ============================================================================
# ⚠️ VÌ SAO PHẢI LÀM THẾ NÀY (bài học từ phiên bản cũ):
#
#   Ở bản v1.4 cũ, Client Secret bị viết thẳng vào mã nguồn
#   src/main/services/GoogleOAuthService.js dòng 29. Vì mã nguồn được Git theo
#   dõi và đã đẩy lên GitHub, mật khẩu đó đã bị công khai ra Internet.
#
#   Nguyên tắc bất di bất dịch: BÍ MẬT KHÔNG BAO GIỜ NẰM TRONG MÃ NGUỒN.
#   - Tệp .env         → chứa giá trị thật, đã bị .gitignore chặn, KHÔNG lên Git
#   - Tệp .env.example → chỉ chứa tên biến và hướng dẫn, được phép lên Git
#
#   Nhờ vậy Anh chia sẻ mã nguồn cho bất kỳ ai cũng không lộ mật khẩu.
# ============================================================================

# Client ID của ứng dụng OAuth 2.0 (dạng: <số>-<chuỗi>.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

# Client Secret của ứng dụng OAuth 2.0 (dạng: GOCSPX-...)
# ⚠️ TUYỆT ĐỐI không dán giá trị này vào chat, email, hay ảnh chụp màn hình.
GOOGLE_CLIENT_SECRET=

# (Không bắt buộc) Cổng máy chủ Loopback nhận phản hồi đăng nhập từ Google.
# Chỉ đổi nếu cổng 8089 đã bị ứng dụng khác chiếm dụng.
GOOGLE_OAUTH_PORT=8089
