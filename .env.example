# ============================================================================
# QUEEN STONE — CẤU HÌNH MÔI TRƯỜNG MÁY CHỦ INTERNET (.env)
# ============================================================================
# Hướng dẫn: Tạo tệp .env cùng cấp với tệp này và tùy chỉnh các giá trị dưới đây:

# 1. CỔNG MẠNG & HOST MÁY CHỦ
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# 2. BẢO MẬT TÀI KHOẢN QUẢN TRỊ VIÊN (ADMIN PORTAL /admin)
# Tên đăng nhập mặc định: Admin
ADMIN_USERNAME=Admin
# Mật khẩu quản trị (Hãy đổi mật khẩu phức tạp hơn khi đưa lên internet công cộng!)
ADMIN_PASSWORD=8888

# 3. MÃ PIN BẢO VỆ XUẤT KHO & THÊM ẢNH NHANH
ADMIN_PIN=1234

# 4. ĐƯỜNG DẪN CSDL SQLITE (Mặc định: data/queen_stone.db)
# DB_PATH=data/queen_stone.db
